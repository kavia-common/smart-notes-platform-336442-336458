# Backend configuration (copy to .env and fill in)
# Note: the orchestrator/user will set these in the real environment.

# PostgreSQL (provided by the notes_database container)
POSTGRES_URL=postgresql://appuser:dbpassword@localhost:5001/mydb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=mydb
POSTGRES_PORT=5001

# Frontend origin for CORS (Next.js dev/prod URL)
FRONTEND_ORIGIN=http://localhost:3000
